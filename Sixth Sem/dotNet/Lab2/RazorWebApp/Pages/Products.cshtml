@page
@model RazorWebApp.Pages.ProductsModel
@{
    ViewData["Title"] = "Northwind Products";
}

<h1 class="my-4">Northwind Products</h1>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Product Name</th>
            <th>Price (USD)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.ProductName</td>
                <td>$@string.Format("{0:F2}", product.UnitPrice)</td>
            </tr>
        }
    </tbody>
</table>
